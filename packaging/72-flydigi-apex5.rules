# Flydigi Apex 5: give the logged-in user access to the vendor hidraw node.
# The number must sort before systemd's 73-seat-late.rules for uaccess to apply.
KERNEL=="hidraw*", ATTRS{idVendor}=="37d7", ATTRS{idProduct}=="2501", TAG+="uaccess"
# The screen chip's bootloader port (command 31 for chip 4), for picture uploads.
# ModemManager must leave it alone: it would probe the port with AT commands.
KERNEL=="ttyACM*", ATTRS{idVendor}=="ffaa", ATTRS{idProduct}=="5555", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"
